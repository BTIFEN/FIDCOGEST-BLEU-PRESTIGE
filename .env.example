# Server configuration
PORT=3000
NODE_ENV=production

# Administration de FIDCOGEST (Sécurité renforcée)
# Définir un mot de passe fort pour l'interface /admin
ADMIN_PASSWORD=

# Intégration WordPress Headless (fidcogestv2.indusale.top)
WORDPRESS_URL=https://fidcogestv2.indusale.top

# Clé secrète de webhook pour la purge du cache (Obligatoire, min 24 caractères hexadécimaux ou aléatoires)
# Doit être strictement identique à celle configurée dans WordPress (menu FIDCOGEST > Connexion & Webhook)
# Ne pas utiliser de mot de passe administrateur ici !
WP_WEBHOOK_SECRET=

# Google Gemini API key (server-side only, facultatif pour l'assistant fiscal et OCR)

GEMINI_API_KEY=
