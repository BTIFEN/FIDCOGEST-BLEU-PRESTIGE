{
  "name": "fidcogest-bleu-prestige",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "dev": "VITE_DEV=true NODE_ENV=development tsx server.ts",
    "build:client": "vite build",
    "build:server": "esbuild server.ts --bundle --platform=node --format=esm --target=node22 --packages=external --outfile=server.mjs",
    "build": "npm run build:client && npm run build:server && npm run build:bootstrap",
    "start": "NODE_ENV=production node server.js",
    "preview": "vite preview",
    "clean": "rm -rf dist server.mjs",
    "lint": "tsc --noEmit",
    "build:bootstrap": "esbuild scripts/bootstrap-admin.ts --bundle --platform=node --format=esm --target=node22 --packages=external --outfile=bootstrap-admin.mjs && esbuild scripts/enroll-admin.ts --bundle --platform=node --format=esm --target=node22 --packages=external --outfile=enroll-admin.mjs",
    "bootstrap:admin": "node bootstrap-admin.mjs",
    "test:security-static": "node --test tests/security-static.test.mjs",
    "test:bootstrap": "node --import tsx --test tests/private-bootstrap.integration.test.ts"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "esbuild": "^0.28.0",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-router-dom": "^7.18.4",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  }
}
